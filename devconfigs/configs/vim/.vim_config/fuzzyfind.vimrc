nmap <leader>ff :FufFile<cr>
nmap <leader>fj :FufJumpList<cr>
nmap <leader>fc :FufChangeList<cr>
nmap <leader>fl :FufLine<cr>
nmap <leader>fb :FufBuffer<cr>

"nmap <leader> :FufCoverageFile| - Coverage-File mode
"nmap <leader> :FufDir|          - Directory mode
"nmap <leader> :FufMruFile|      - MRU-File mode
"nmap <leader> :FufMruCmd|       - MRU-Command mode
"nmap <leader> :FufBookmarkFile| - Bookmark-File mode
"nmap <leader> :FufBookmarkDir|  - Bookmark-Dir mode
"nmap <leader> :FufTag|          - Tag mode
"nmap <leader> :FufBufferTag|    - Buffer-Tag mode
"nmap <leader> :FufTaggedFile|   - Tagged-File mode
"nmap <leader> :FufHelp|         - Help mode
"nmap <leader> :FufQuickfix|     - Quickfix mode
